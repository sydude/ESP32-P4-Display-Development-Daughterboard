(kicad_wks
	(version 20231118)
	(generator "pl_editor")
	(generator_version "10.0")
	(setup
		(textsize 1.5 1.5)
		(linewidth 0.15)
		(textlinewidth 0.15)
		(left_margin 10)
		(right_margin 10)
		(top_margin 10)
		(bottom_margin 10)
	)
	(rect
		(name "")
		(start 138.989 35.5022)
		(end 1.989 2.0002)
		(comment "rect around the title block")
	)
	(rect
		(name "")
		(start 0 0 ltcorner)
		(end 0 0)
		(repeat 2)
		(incrx 2)
		(incry 2)
	)
	(line
		(name "")
		(start 50 2 ltcorner)
		(end 50 0 ltcorner)
		(repeat 30)
		(incrx 50)
	)
	(tbtext "1"
		(name "")
		(pos 25 1 ltcorner)
		(font
			(size 1.3 1.3)
		)
		(repeat 100)
		(incrx 50)
	)
	(line
		(name "")
		(start 50 2 lbcorner)
		(end 50 0 lbcorner)
		(repeat 30)
		(incrx 50)
	)
	(tbtext "1"
		(name "")
		(pos 25 1 lbcorner)
		(font
			(size 1.3 1.3)
		)
		(repeat 100)
		(incrx 50)
	)
	(line
		(name "")
		(start 0 50 ltcorner)
		(end 2 50 ltcorner)
		(repeat 30)
		(incry 50)
	)
	(tbtext "A"
		(name "")
		(pos 1 25 ltcorner)
		(font
			(size 1.3 1.3)
		)
		(justify center)
		(repeat 100)
		(incry 50)
	)
	(line
		(name "")
		(start 0 50 rtcorner)
		(end 2 50 rtcorner)
		(repeat 30)
		(incry 50)
	)
	(tbtext "A"
		(name "")
		(pos 1 25 rtcorner)
		(font
			(size 1.3 1.3)
		)
		(justify center)
		(repeat 100)
		(incry 50)
	)
	(tbtext "Date: ${ISSUE_DATE}"
		(name "")
		(pos 116 6.9002)
	)
	(line
		(name "")
		(start 139 5.486)
		(end 1.989 5.502)
	)
	(tbtext "${KICAD_VERSION}"
		(name "")
		(pos 138 4.1002)
		(comment "Kicad version")
	)
	(line
		(name "")
		(start 139 8.5)
		(end 1.989 8.502)
	)
	(tbtext "Rev: ${REVISION}"
		(name "")
		(pos 53 6.9002)
		(font bold)
	)
	(tbtext "Size: ${PAPER}"
		(name "")
		(pos 138 6.9002)
		(comment "Paper format name")
	)
	(tbtext "Id: ${#}/${##}"
		(name "")
		(pos 53 4.1002)
		(comment "Sheet id")
	)
	(line
		(name "")
		(start 139 12.5002)
		(end 1.989 12.0022)
	)
	(tbtext "Title: ${TITLE}"
		(name "")
		(pos 138 10.7002)
		(font
			(size 2 2) bold italic)
	)
	(tbtext "File: ${FILENAME}"
		(name "")
		(pos 138 14.3002)
	)
	(line
		(name "")
		(start 139 18.5002)
		(end 1.989 18.5022)
	)
	(tbtext "Sheet: ${SHEETPATH}"
		(name "")
		(pos 138 17.0002)
	)
	(tbtext "${COMPANY}"
		(name "")
		(pos 138 20.0002)
		(font bold)
		(comment "Company name")
	)
	(tbtext "${COMMENT1}"
		(name "")
		(pos 138 23.0002)
		(comment "Comment 0")
	)
	(tbtext "${COMMENT2}"
		(name "")
		(pos 138 26.0002)
		(comment "Comment 1")
	)
	(tbtext "${COMMENT3}"
		(name "")
		(pos 138 29.0002)
		(comment "Comment 2")
	)
	(tbtext "${COMMENT4}"
		(name "")
		(pos 138 32.0002)
		(comment "Comment 3")
	)
	(line
		(name "")
		(start 119 8.5002)
		(end 119 5.5002)
	)
	(line
		(name "")
		(start 55 8.5002)
		(end 55 2.0002)
	)
)
